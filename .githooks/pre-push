#!/bin/sh
#
# Runs what CI gates on, before the code leaves this machine — so a red run is
# caught here instead of on GitHub.
#
# Enable once: ./scripts/setup-hooks.sh
# Bypass once: git push --no-verify

if ! command -v cargo >/dev/null 2>&1; then
    echo "pre-push: cargo not found, skipping checks" >&2
    exit 0
fi

echo "pre-push: cargo clippy --workspace --all-targets -- -D warnings"
if ! cargo clippy --workspace --all-targets -- -D warnings; then
    echo >&2
    echo "Clippy failed. Fix the warnings above before pushing." >&2
    exit 1
fi

# Skipped rather than enforced when the tool is missing: CI is the hard gate,
# and a hook that blocks a push over an uninstalled helper is just in the way.
if command -v cargo-machete >/dev/null 2>&1; then
    echo "pre-push: cargo machete"
    if ! cargo machete; then
        echo >&2
        echo "Unused dependencies found. Remove them, or list them under" >&2
        echo "[package.metadata.cargo-machete] if the detection is wrong." >&2
        exit 1
    fi
else
    echo "pre-push: cargo-machete not installed, skipping" >&2
    echo "           (cargo install cargo-machete)" >&2
fi

# Tests are a hard gate, unlike the helper above, so a missing runner stops
# the push — but say how to get it instead of leaving a bare cargo error.
if ! command -v cargo-nextest >/dev/null 2>&1; then
    echo "pre-push: cargo-nextest not installed" >&2
    echo "           install it with 'just setup'" >&2
    echo "           (or: cargo install --locked cargo-nextest)" >&2
    exit 1
fi

echo "pre-push: cargo nextest run --workspace"
if ! cargo nextest run --workspace; then
    echo >&2
    echo "Tests failed. Fix them before pushing." >&2
    exit 1
fi
